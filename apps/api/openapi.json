    "/api/v1/dashboard/load-estimate": {
      "get": {
        "summary": "Get Load Estimate",
        "operationId": "get_load_estimate_api_v1_dashboard_load_estimate_get",
        "parameters": [
          {
            "name": "n_students",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2000,
