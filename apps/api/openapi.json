    "/api/v1/dashboard/escalations/{escalation_id}": {
      "patch": {
        "summary": "Update Escalation Status",
        "operationId": "update_escalation_status_api_v1_dashboard_escalations__escalation_id__patch",
        "parameters": [
          {
            "name": "escalation_id",
