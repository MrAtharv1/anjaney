      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AggregateCheckinRequest": {
        "properties": {
          "pseudonymous_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Pseudonymous Id"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date"
          },
          "risk_category": {
            "type": "string",
            "pattern": "^(LOW_RISK_TREND|ELEVATED_TREND|ESCALATE_TO_HUMAN)$",
            "title": "Risk Category"
          },
          "data_quality": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Data Quality"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "1.0.0"
          }
        },
        "type": "object",
        "required": [
          "pseudonymous_id",
          "date",
          "risk_category",
          "data_quality"
        ],
        "title": "AggregateCheckinRequest",
        "description": "Contains zero free-text fields."
      },
      "ConsentRequest": {
        "properties": {
          "pseudonymous_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Pseudonymous Id"
          },
          "share_aggregate": {
            "type": "boolean",
            "title": "Share Aggregate",
            "default": false
          },
          "share_escalation": {
            "type": "boolean",
            "title": "Share Escalation",
            "default": false
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "1.0"
          }
        },
        "type": "object",
        "required": [
          "pseudonymous_id"
        ],
        "title": "ConsentRequest"
      },
      "EscalationRequest": {
        "properties": {
          "pseudonymous_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Pseudonymous Id"
          },
          "risk_category": {
            "type": "string",
            "title": "Risk Category"
          },
          "interval_lower": {
            "type": "number",
            "title": "Interval Lower"
          },
          "interval_upper": {
            "type": "number",
            "title": "Interval Upper"
          },
          "consent_note": {
            "type": "boolean",
            "title": "Consent Note",
            "default": false
          },
          "optional_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Optional Note"
          }
        },
        "type": "object",
        "required": [
          "pseudonymous_id",
          "risk_category",
          "interval_lower",
          "interval_upper"
        ],
        "title": "EscalationRequest"
      },
      "EscalationStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(new|acknowledged|referred|closed)$",
            "title": "Status"
          },
          "counsellor_username": {
            "type": "string",
            "title": "Counsellor Username"
          }
        },
        "type": "object",
        "required": [
          "status",
          "counsellor_username"
        ],
        "title": "EscalationStatusUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoadEstimateResponse": {
        "properties": {
          "n_students": {
            "type": "integer",
            "title": "N Students"
          },
          "n_counsellors": {
            "type": "integer",
            "title": "N Counsellors"
          },
          "capacity_per_day": {
            "type": "integer",
            "title": "Capacity Per Day"
          },
          "abstention_rate_used": {
            "type": "number",
            "title": "Abstention Rate Used"
          },
          "expected_daily_escalations": {
            "type": "number",
            "title": "Expected Daily Escalations"
          },
          "capacity_sufficient": {
            "type": "boolean",
            "title": "Capacity Sufficient"
          }
        },
        "type": "object",
        "required": [
          "n_students",
          "n_counsellors",
          "capacity_per_day",
          "abstention_rate_used",
          "expected_daily_escalations",
          "capacity_sufficient"
        ],
        "title": "LoadEstimateResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}